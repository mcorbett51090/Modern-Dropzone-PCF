<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<manifest>
  <control namespace="GorgonUK" constructor="Dropzone" version="2026.4.8" display-name-key="Modern Dropzone" description-key="Modern Dropzone component for Dynamics365 that integrates with Notes and SharePoint OOTB" control-type="virtual">
    <data-set name="sampleDataSet" display-name-key="Select any table" />

    <!--
      ============================================================
      CUSTOM PROPERTY: sharePointOnlyMode  (added 2026-04-08)
      ============================================================
      When set to Yes (true, the default):
        - SharePoint mode is forced ON at startup
        - The SharePoint/Notes toggle is hidden
        - The "Remember Location" settings callout is hidden
        - The SP document-locations dropdown is hidden
        - Note drops are completely disabled
        - allowNoteDrops / allowSharePointDrops are overridden internally

      Set to No to restore the original toggle-based behaviour.
      ============================================================
    -->
    <property name="sharePointOnlyMode"
              display-name-key="SharePoint Only Mode?"
              description-key="When Yes: forces SharePoint uploads, hides the toggle, hides the document-location dropdown and settings callout, and disables Note drops entirely. Set to No to restore the original toggle behaviour."
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />

    <!-- Existing properties – unchanged for full backward-compatibility -->
    <property name="enableSharePointDocuments"
              display-name-key="Enable SharePoint Integration?"
              description-key="Simply provide Yes/No"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />
    <property name="allowNoteDrops"
              display-name-key="Allow Note drops?"
              description-key="Allow users to upload documents to Notes? (overridden to No when SharePoint Only Mode is Yes)"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />
    <property name="allowSharePointDrops"
              display-name-key="Allow SharePoint drops?"
              description-key="Allow users to upload documents to SharePoint?"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />
    <property name="displayNotesViewsControl"
              display-name-key="Display Notes views dropdown?"
              description-key="Enable users to change Notes views"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />
    <property name="enableNotesViewsControl"
              display-name-key="Enable Notes views dropdown?"
              description-key="Enable users to change Notes views"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />
    <property name="displaySharePointDocumentLocationsControl"
              display-name-key="Display SharePoint document locations dropdown?"
              description-key="Enable users to change SP Document Location (overridden to hidden when SharePoint Only Mode is Yes)"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />
    <property name="enableSharePointDocumentLocationsControl"
              display-name-key="Enable SharePoint document locations dropdown?"
              description-key="Enable users to change SP Document Location"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />
    <property name="defaultNotesView"
              display-name-key="Default Notes View"
              description-key="Default Notes view"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <resources>
      <code path="index.ts" order="1" />
      <platform-library name="React" version="16.8.6" />
      <platform-library name="Fluent" version="8.29.0" />
      <css path="css/Dropzone.css" order="2" />
      <resx path="strings/Dropzone.1033.resx" version="1.0.0" />
      <resx path="strings/Dropzone.2057.resx" version="1.0.0" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="false" />
      <uses-feature name="WebAPI.retrieveMultipleRecords" required="false" />
    </feature-usage>
  </control>
</manifest>
